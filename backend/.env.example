OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
NVD_API_KEY=
DATABASE_URL=sqlite:///./phantomscan.db
SELF_AUDIT_WEBHOOK=http://localhost:8000/api/logs/alert
FRONTEND_URL=http://localhost:5173
ACTIVE_TARGET_ALLOWLIST=
MAX_SCAN_DURATION=300
MAX_REQUESTS_PER_SECOND=2
MAX_TOTAL_REQUESTS=300
MAX_CONCURRENT_SCANS=2
MAX_REDIRECT_DEPTH=0
MAX_RESPONSE_SIZE=1048576
BROWSER_PAGE_LIMIT=8

# ── Exploitation Engine (all OFF by default; enable consciously) ──────────────
# Global kill-switches. Exploitation still requires the user to tick
# "Enable Exploitation" per scan on the Authorized Testing page, and only
# runs against verified / Private-Scope / lab targets in pentest mode.
EXPLOITATION_ENABLED=false
AI_EXPLOITATION_ENABLED=false
# AI exploitation falls back to deterministic templates when no API key is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Per-attempt timeout (seconds) and cap on exploited findings per scan.
EXPLOIT_ATTEMPT_TIMEOUT=30
EXPLOIT_MAX_FINDINGS=10

# ── Brutal Mode (Black Ops) ────────────────────────────────────────────────────
BRUTAL_MODE_ENABLED=false
# Command budget and timeout per shell session (destructive commands are always
# blocked and audited regardless of budget).
BRUTAL_MAX_COMMANDS_PER_SHELL=100
BRUTAL_COMMAND_TIMEOUT=12
# Loot archive password. When empty, the key is derived from SECRET_KEY +
# session_id so the server can still decrypt its own archives.
BRUTAL_EXFIL_PASSWORD=
# Evasion toggles — keep OFF so canned lab keyword-matching works.
BRUTAL_EVASION_OBFUSCATE=false
BRUTAL_EVASION_SLOW_SCAN=false

# Supabase Auth (Google / GitHub login)
# SUPABASE_URL is required. Verification: set SUPABASE_JWT_SECRET (local HS256
# decode) OR leave it empty to verify via the REST /auth/v1/user endpoint
# (SUPABASE_ANON_KEY recommended for the REST path; the anon key is public).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ADMIN_EMAILS=

# Local JWT Auth
SECRET_KEY=