# Frontend environment variables
# Copy this file to .env and update values for your setup

# Browser-facing backend API URL. Do not append /api; api.ts adds endpoint prefixes.
VITE_API_BASE_URL=http://localhost:8000

# Browser-facing WebSocket URL.
VITE_WS_BASE_URL=ws://localhost:8000

# Supabase Auth (Google / GitHub login) — from Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
