# PhantomScan root environment template
# Copy to .env for root-level tooling. Backend also reads backend/.env.
# Do not put real secrets in committed example files.

# Required for local/backend auth
SECRET_KEY=

# Active runtime database: SQLite via backend/app/database.py
# PostgreSQL/SQLAlchemy files are retained only as future migration infrastructure.
DATABASE_URL=sqlite:///./phantomscan.db

# Browser-facing origins
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Optional AI / CVE enrichment
LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NVD_API_KEY=
AI_MAX_MODULES=10
AI_POC_MAX_PER_SCAN=5

# Optional GitHub OAuth / GitHub App integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional Supabase Auth (Google / GitHub login)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ADMIN_EMAILS=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Active-testing safety controls
ACTIVE_TARGET_ALLOWLIST=
VERIFICATION_TTL_DAYS=30
VERIFICATION_CHALLENGE_MINUTES=60
MAX_SCAN_DURATION=300
MAX_REQUESTS_PER_SECOND=2
MAX_TOTAL_REQUESTS=300
MAX_CONCURRENT_SCANS=2
ACTIVE_MAX_CONCURRENCY=20
MAX_REDIRECT_DEPTH=0
MAX_RESPONSE_SIZE=1048576
BROWSER_PAGE_LIMIT=8
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.60
CALLBACK_DOMAIN=
CALLBACK_BASE_URL=
CALLBACK_WAIT_TIMEOUT=5.0
DEEP_PORT_SCAN=1
PORT_SCAN_CONCURRENCY=64
PORT_SCAN_MAX_PORTS=1024
PORT_SCAN_SWEEP_TIMEOUT=75.0

# Exploitation engine: all OFF by default; enable consciously.
EXPLOITATION_ENABLED=false
AI_EXPLOITATION_ENABLED=false
EXPLOIT_ATTEMPT_TIMEOUT=30
EXPLOIT_MAX_FINDINGS=10
EXPLOIT_SANDBOX=auto
EXPLOIT_DOCKER_IMAGE=python:3.12-slim

# Brutal Mode (Black Ops): OFF by default and gated server-side.
BRUTAL_MODE_ENABLED=false
BRUTAL_EXFIL_DIR=
BRUTAL_MAX_COMMANDS_PER_SHELL=100
BRUTAL_COMMAND_TIMEOUT=12
BRUTAL_EXFIL_PASSWORD=
BRUTAL_EVASION_OBFUSCATE=false
BRUTAL_EVASION_SLOW_SCAN=false

# Optional notifications / observability
PHANTOMSCAN_WEBHOOK_URL=
SELF_AUDIT_WEBHOOK=http://localhost:8000/api/logs/alert
REQUIRE_AUTH_ON_HEALTH=false
REQUIRE_AUTH_ON_WEBSOCKET=true
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key
API_KEY_VALUE=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=phantomscan
PROMETHEUS_METRICS_ENABLED=true

# Optional/future services. Not required by the current SQLite runtime.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
PG_POOL_MIN_SIZE=5
PG_POOL_MAX_SIZE=20
PG_POOL_TIMEOUT=30.0
PG_COMMAND_TIMEOUT=60.0
